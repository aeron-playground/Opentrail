{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentrail-docs",
  "compatibility_date": "2026-09-18",
  // Static files only: no Worker code runs. /faq serves faq.html, and unknown paths get 404.html.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // The site lives only at its own address. Pull request previews still get a workers.dev URL.
  "workers_dev": false,
  "preview_urls": true,
  // Until the project has its own domain (see ADR 0014).
  "routes": [{ "pattern": "opentrail.mraeron.tech", "custom_domain": true }]
}
