# Copy to .env in this folder. `bun run dev` reads it.
# Everything here ships to every browser: never put a secret in a VITE_ value.

# Where the API answers. The local API from `bun run dev`.
VITE_API_URL=http://localhost:3001

# Where live updates connect. Left empty, it's the API's address with ws:// (or wss://) and /v1/ws.
VITE_WS_URL=

# The public app id of your Privy app (dashboard.privy.io → App settings). Left empty, the app
# runs and sign-in says it isn't set up.
VITE_PRIVY_APP_ID=
