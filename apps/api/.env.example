# Copy to .env in this folder. `bun run dev` reads it.

# The local Postgres from `bun run db:up`.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Browser origins allowed to call the API, separated by commas. Never "*".
CORS_ORIGINS=http://localhost:5173

# From your Privy app at dashboard.privy.io (App settings). The app id is public; the secret is
# not: put it only in .env, which git ignores. With these placeholders the API starts, but every
# sign-in is refused.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# The Solana server for balances. The public one works for development (servers may use it;
# browsers can't). Production uses a provider URL with a key, which is a secret.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

PORT=3001

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
