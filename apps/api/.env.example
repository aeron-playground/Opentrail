# Copy to .env in this folder. `bun run dev` reads it.

# The local Postgres from `bun run db:up`.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Browser origins allowed to call the API, separated by commas. Never "*".
CORS_ORIGINS=http://localhost:5173

PORT=3001

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
