# Copy to .env in this folder. `bun run dev` reads it.

# The local Postgres from `bun run db:up`.
DATABASE_URL=postgres://app:app@localhost:5432/app

# The value Helius sends in the Authorization header of every webhook delivery.
# This one is for local development only. Production uses a random value of 32 or more characters.
HELIUS_WEBHOOK_SECRET=local-development-secret-not-for-production

# Optional, but set both or neither. With both, the indexer adds each new user's wallet to the
# webhook, so Helius delivers that wallet's transactions. The API key (dashboard.helius.dev, API
# keys) is a secret: put it only in .env, which git ignores. The webhook id is on the webhook's
# page; the webhook must be of type "raw". Leave both empty to keep the address sync off.
HELIUS_API_KEY=
HELIUS_WEBHOOK_ID=

# Optional locally, needed in production. Token prices come from Jupiter's Price API; without a
# key they use its keyless address, which Jupiter plans to retire. The key is a secret: put it only
# in .env, which git ignores.
JUPITER_API_KEY=

# Optional. Where GeckoTerminal answers, for price candles; the public API when empty.
GECKOTERMINAL_BASE_URL=

PORT=3002

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
