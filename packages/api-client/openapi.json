{
  "openapi": "3.1.0",
  "info": {
    "title": "Opentrail API",
    "version": "1",
    "description": "Every response has an x-request-id header, and every error uses the Error shape. Amounts are strings, and times are ISO 8601 in UTC."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Privy access token, sent as `Authorization: Bearer <token>`. The web and mobile apps get one when the person signs in."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable, machine-readable code. Handle codes you don't know as a generic error.",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "description": "A sentence you can show to the user.",
                "example": "We couldn't find that."
              },
              "requestId": {
                "type": "string",
                "description": "The same id as the x-request-id header. Quote it when you report a problem.",
                "example": "0192b6f0-7c1e-7a3b-9d7e-3f5c1a2b4d6e"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok",
                  "down"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Your account id.",
            "example": "0192b6f0-7c1e-7a3b-9d7e-3f5c1a2b4d6e"
          },
          "username": {
            "type": "string",
            "description": "Your public name. New accounts get a random one, such as calm_otter_42.",
            "example": "calm_otter_42"
          },
          "usernameChosen": {
            "type": "boolean",
            "description": "False until you choose a name or keep the random one, for example during onboarding.",
            "example": false
          },
          "usernameChangeableAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When you can change your username again (once every 30 days), or null if you can change it now.",
            "example": null
          },
          "walletAddress": {
            "type": "string",
            "description": "Your Solana wallet address, where you add funds. It comes from your sign-in on the server, never from the request."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the account was created.",
            "example": "2026-09-26T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "username",
          "usernameChosen",
          "usernameChangeableAt",
          "walletAddress",
          "createdAt"
        ]
      },
      "MeUpdate": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Your new username: 3–20 characters, a–z, 0–9 and _, starting with a letter. It's saved in lowercase. Send your current name to keep it.",
            "example": "maya"
          }
        },
        "required": [
          "username"
        ]
      },
      "Balances": {
        "type": "object",
        "properties": {
          "balances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Balance"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When these amounts were read from Solana.",
            "example": "2026-09-26T10:00:00.000Z"
          }
        },
        "required": [
          "balances",
          "updatedAt"
        ]
      },
      "Balance": {
        "type": "object",
        "properties": {
          "token": {
            "$ref": "#/components/schemas/Token"
          },
          "amountRaw": {
            "type": "string",
            "description": "In the token's smallest unit, as a string so no digit is lost: 50 USDC is \"50000000\".",
            "example": "50000000"
          }
        },
        "required": [
          "token",
          "amountRaw"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "example": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
          },
          "symbol": {
            "type": "string",
            "example": "USDC"
          },
          "decimals": {
            "type": "integer",
            "description": "How many of the raw amount's digits come after the decimal point.",
            "example": 6
          }
        },
        "required": [
          "mint",
          "symbol",
          "decimals"
        ]
      },
      "UsernameSuggestion": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "A random name that nobody has right now.",
            "example": "calm_otter_42"
          }
        },
        "required": [
          "username"
        ]
      },
      "UsernameAvailability": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The name as it would be saved: in lowercase.",
            "example": "maya"
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "description": "Why the name isn't available: `taken` (someone has it, maybe you), `reserved` (blocked, or too close to a blocked name) or `invalid` (breaks the format). Treat any other value as not available.",
            "example": "taken"
          }
        },
        "required": [
          "username",
          "available"
        ]
      },
      "TokenList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenListItem"
            }
          },
          "nextCursor": {
            "type": "null",
            "description": "Always null: the whole list comes in one page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "TokenListItem": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "description": "The token's mint address.",
            "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
          },
          "symbol": {
            "type": "string",
            "example": "JUP"
          },
          "name": {
            "type": "string",
            "example": "Jupiter"
          },
          "decimals": {
            "type": "integer",
            "description": "How many of a raw amount's digits come after the decimal point.",
            "example": 6
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://static.jup.ag/jup/icon.png"
          },
          "priceUsd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dollars per whole token, as a decimal string. Null before the token's first price.",
            "example": "0.3253799780422554"
          },
          "change24hPct": {
            "type": [
              "string",
              "null"
            ],
            "description": "The price change over the last 24 hours, in percent: -4.82 means down 4.82%.",
            "example": "-4.8212"
          },
          "priceUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the price was last confirmed; prices refresh about every 15 seconds, so an older time means the price is stale.",
            "example": "2026-09-30T12:00:00.000Z"
          },
          "rank": {
            "type": "integer",
            "description": "Place in the list, from 1.",
            "example": 2
          },
          "sparkline7d": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Closing prices every 4 hours over the last 7 days, oldest first, as decimal strings. Shorter for a token listed recently.",
            "example": [
              "0.3312",
              "0.3290",
              "0.3254"
            ]
          }
        },
        "required": [
          "mint",
          "symbol",
          "name",
          "decimals",
          "logoUrl",
          "priceUsd",
          "change24hPct",
          "priceUpdatedAt",
          "rank",
          "sparkline7d"
        ]
      },
      "TokenDetail": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "description": "The token's mint address.",
            "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
          },
          "symbol": {
            "type": "string",
            "example": "JUP"
          },
          "name": {
            "type": "string",
            "example": "Jupiter"
          },
          "decimals": {
            "type": "integer",
            "description": "How many of a raw amount's digits come after the decimal point.",
            "example": 6
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://static.jup.ag/jup/icon.png"
          },
          "priceUsd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dollars per whole token, as a decimal string. Null before the token's first price.",
            "example": "0.3253799780422554"
          },
          "change24hPct": {
            "type": [
              "string",
              "null"
            ],
            "description": "The price change over the last 24 hours, in percent: -4.82 means down 4.82%.",
            "example": "-4.8212"
          },
          "priceUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the price was last confirmed; prices refresh about every 15 seconds, so an older time means the price is stale.",
            "example": "2026-09-30T12:00:00.000Z"
          },
          "isListed": {
            "type": "boolean",
            "description": "Whether the token can be traded. USDC, which you pay with, isn't.",
            "example": true
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Place in the list, from 1; null for a token that isn't listed.",
            "example": 2
          },
          "safety": {
            "$ref": "#/components/schemas/TokenSafety"
          },
          "stats": {
            "$ref": "#/components/schemas/TokenStats"
          }
        },
        "required": [
          "mint",
          "symbol",
          "name",
          "decimals",
          "logoUrl",
          "priceUsd",
          "change24hPct",
          "priceUpdatedAt",
          "isListed",
          "rank",
          "safety",
          "stats"
        ]
      },
      "TokenSafety": {
        "type": "object",
        "properties": {
          "level": {
            "type": [
              "string",
              "null"
            ],
            "description": "`ok`, `caution` or `high_risk`, or null before the token is checked. A string, not a list: treat a level you don't know as `caution`.",
            "example": "ok"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "The reviewed reason behind the level, to show on the token page.",
            "example": null
          }
        },
        "required": [
          "level",
          "note"
        ]
      },
      "TokenStats": {
        "type": "object",
        "properties": {
          "marketCapUsd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Market cap in dollars; null when unknown.",
            "example": null
          },
          "liquidityUsd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dollars in the token's pools; null when unknown.",
            "example": null
          },
          "volume24hUsd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dollars traded in the last 24 hours; null when unknown.",
            "example": null
          }
        },
        "required": [
          "marketCapUsd",
          "liquidityUsd",
          "volume24hUsd"
        ]
      },
      "CandleList": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
          },
          "timeframe": {
            "type": "string",
            "enum": [
              "15m",
              "1h",
              "4h",
              "1d"
            ],
            "example": "1h"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candle"
            }
          }
        },
        "required": [
          "mint",
          "timeframe",
          "items"
        ]
      },
      "Candle": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "When the candle's period starts. The newest candle is still open.",
            "example": "2026-09-30T08:00:00.000Z"
          },
          "open": {
            "type": "string",
            "description": "Dollars per whole token when the period opened.",
            "example": "0.3312"
          },
          "high": {
            "type": "string",
            "description": "The highest price in the period.",
            "example": "0.3330"
          },
          "low": {
            "type": "string",
            "description": "The lowest price in the period.",
            "example": "0.3251"
          },
          "close": {
            "type": "string",
            "description": "The latest price in the period.",
            "example": "0.3254"
          },
          "volumeUsd": {
            "type": "string",
            "description": "Dollars traded in the token's main pool in the period.",
            "example": "26262.57"
          }
        },
        "required": [
          "start",
          "open",
          "high",
          "low",
          "close",
          "volumeUsd"
        ]
      },
      "SwapQuote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The intent to submit the signed transaction to.",
            "example": "0192b6f0-7c1e-7a3b-9d7e-3f5c1a2b4d6e"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "mint": {
            "type": "string",
            "description": "The token bought or sold."
          },
          "inputMint": {
            "type": "string",
            "description": "The token the swap spends."
          },
          "outputMint": {
            "type": "string",
            "description": "The token the swap brings."
          },
          "inAmountRaw": {
            "type": "string",
            "description": "What you spend, as asked; for a buy, the fee included. In raw units, as a string so no digit is lost.",
            "example": "25000000"
          },
          "expectedOutRaw": {
            "type": "string",
            "description": "What the swap expects to bring. On a sell, the fee comes out of it after the swap. In raw units, as a string so no digit is lost.",
            "example": "79230250"
          },
          "minOutRaw": {
            "type": "string",
            "description": "The least the swap may bring before it fails, after slippage. On a sell, the fee comes out of it after the swap. In raw units, as a string so no digit is lost.",
            "example": "78834099"
          },
          "feeBps": {
            "type": "integer",
            "description": "The platform fee rate; 0 with fees off.",
            "example": 10
          },
          "feeUsdcMicro": {
            "type": "string",
            "description": "The platform fee, in micro-USDC. In raw units, as a string so no digit is lost.",
            "example": "25000"
          },
          "slippageBps": {
            "type": "integer",
            "example": 50
          },
          "priceImpactBps": {
            "type": "integer",
            "description": "How much this trade moves the price, rounded up. Show a warning from 100.",
            "example": 3
          },
          "routeLabel": {
            "type": "string",
            "description": "The venues the swap goes through.",
            "example": "GoonFi V2 → PancakeSwap → Raydium CLMM"
          },
          "providerFeeBps": {
            "type": "integer",
            "description": "The swap provider's own fee; 0 when it takes none. Show it as its own line above 0.",
            "example": 0
          },
          "networkFeeLamports": {
            "type": "string",
            "description": "The most the network can take: the signature fee plus the priority fee. In raw units, as a string so no digit is lost.",
            "example": "58095"
          },
          "transaction": {
            "type": "string",
            "description": "The unsigned transaction, base64. Sign it in the wallet and submit it unchanged."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this quote stops being accepted: 45 seconds after it was made.",
            "example": "2026-10-02T09:00:45.000Z"
          }
        },
        "required": [
          "id",
          "side",
          "mint",
          "inputMint",
          "outputMint",
          "inAmountRaw",
          "expectedOutRaw",
          "minOutRaw",
          "feeBps",
          "feeUsdcMicro",
          "slippageBps",
          "priceImpactBps",
          "routeLabel",
          "providerFeeBps",
          "networkFeeLamports",
          "transaction",
          "expiresAt"
        ]
      },
      "SwapQuoteRequest": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "description": "`buy` spends USDC on the token; `sell` sells the token for USDC.",
            "example": "buy"
          },
          "mint": {
            "type": "string",
            "description": "The token to buy or sell. USDC is always the other side.",
            "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
          },
          "amountRaw": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,39}$",
            "description": "A buy: the micro-USDC to spend, the fee included (\"25000000\" is $25). A sell: the token's raw units to sell.",
            "example": "25000000"
          },
          "slippageBps": {
            "type": "integer",
            "minimum": 10,
            "maximum": 300,
            "default": 50,
            "description": "How far the price may move before the trade fails, in basis points (50 is 0.5%). From 10 to 300.",
            "example": 50
          },
          "acceptHighImpact": {
            "type": "boolean",
            "default": false,
            "description": "Send true to go ahead after a `PRICE_IMPACT_TOO_HIGH` refusal (impact of 5% or more).",
            "example": false
          }
        },
        "required": [
          "side",
          "mint",
          "amountRaw"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check that the API and its database are up",
        "description": "Answers 503 when the database doesn't respond within 2 seconds.",
        "responses": {
          "200": {
            "description": "The API and the database are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is down or too slow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get your account",
        "description": "The first call creates your account: it reads your Solana wallet from your sign-in and gives you a random username. Later calls return the same account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Your account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED`: the access token is missing, expired or not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`WALLET_NOT_READY`: your wallet is still being created right after sign-in. Try again in a moment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Account"
        ],
        "summary": "Change your username",
        "description": "Choosing a name, or keeping the random one, counts as a change: the next one is allowed 30 days later. Sending the name you already chose changes nothing.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Your account, with the new name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`: the name breaks the format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED`: the access token is missing, expired or not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`USERNAME_TAKEN`: someone has the name. `USERNAME_RESERVED`: the name is blocked, or too close to a blocked name. `WALLET_NOT_READY`: see GET /v1/me.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "`USERNAME_CHANGE_TOO_SOON`: you changed it less than 30 days ago. `usernameChangeableAt` on GET /v1/me says when you can change it again.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "description": "Seconds until you can change your username again.",
                  "example": "86400"
                },
                "required": true,
                "description": "Seconds until you can change your username again."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/balances": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get your balances",
        "description": "USDC and SOL in your wallet, read from Solana at the `confirmed` level. The answer can be up to 5 seconds old. More tokens will be listed as they're added.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Your balances.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balances"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED`: the access token is missing, expired or not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`WALLET_NOT_READY`: see GET /v1/me.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usernames/suggest": {
      "get": {
        "tags": [
          "Usernames"
        ],
        "summary": "Suggest a username",
        "description": "A random `adjective_animal_NN` name that nobody has. No sign-in needed.",
        "responses": {
          "200": {
            "description": "A free name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameSuggestion"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usernames/{name}/available": {
      "get": {
        "tags": [
          "Usernames"
        ],
        "summary": "Check whether a username is free",
        "description": "Usernames are 3–20 characters: a–z, 0–9 and _, starting with a letter. Case doesn't matter. No sign-in needed.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "example": "maya"
            },
            "required": true,
            "name": "name",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Whether the name is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameAvailability"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`: the name is longer than 64 characters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "summary": "List tokens",
        "description": "The tokens you can trade, in list order, with their latest prices. No sign-in needed. For live prices, subscribe to the WebSocket `prices` channel.",
        "responses": {
          "200": {
            "description": "The tradable tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "summary": "Get a token",
        "description": "One token, tradable or not, with its price, safety and stats. No sign-in needed. Safety and stats are null until the token has been checked.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The token's mint address.",
              "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
            },
            "required": true,
            "description": "The token's mint address.",
            "name": "mint",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenDetail"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`: the mint isn't a Solana address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: no token with this mint address is known.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/candles": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "summary": "Get a token's price candles",
        "description": "Price candles for a chart, oldest first, from the token's main pool on GeckoTerminal. Show \"Chart data: GeckoTerminal\" under every chart. Without `from`, the answer covers 1 day of `15m`, 7 days of `1h`, 30 days of `4h` or 365 days of `1d` candles, up to `to` (now by default). A range may hold at most 1000 candles. No sign-in needed.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The token's mint address.",
              "example": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
            },
            "required": true,
            "description": "The token's mint address.",
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "15m",
                "1h",
                "4h",
                "1d"
              ],
              "description": "How long each candle lasts.",
              "example": "1h"
            },
            "required": true,
            "description": "How long each candle lasts.",
            "name": "tf",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "The earliest candle start to include.",
              "example": "2026-09-23T12:00:00Z"
            },
            "required": false,
            "description": "The earliest candle start to include.",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Candles must start before this time.",
              "example": "2026-09-30T12:00:00Z"
            },
            "required": false,
            "description": "Candles must start before this time.",
            "name": "to",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The candles; an empty list when there are none in the range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleList"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`: the mint isn't a Solana address, `tf` is missing or unknown, a time isn't ISO 8601, `from` isn't before `to`, or the range holds more than 1000 candles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: no token with this mint address is known.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/swaps/quote": {
      "post": {
        "tags": [
          "Trading"
        ],
        "summary": "Quote a trade",
        "description": "Checks the trade, finds a route, and builds one transaction with the swap and the platform fee, simulated before it's returned. Nothing is signed or sent: sign the transaction in your wallet before `expiresAt`. Ask again for a fresh price.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwapQuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The quote and the transaction to sign.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwapQuote"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`, `TOKEN_NOT_SUPPORTED`, `AMOUNT_TOO_SMALL`, `AMOUNT_TOO_LARGE`, `INSUFFICIENT_BALANCE`, `INSUFFICIENT_SOL_FOR_FEES`, `PRICE_IMPACT_TOO_HIGH` (send again with `acceptHighImpact`), or `TX_SIMULATION_FAILED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED`: the access token is missing, expired or not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`WALLET_NOT_READY`: see GET /v1/me.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "`QUOTE_UNAVAILABLE`: no route for this trade right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "`QUOTE_BUSY`: getting a price took too long. Try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
