{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["TEST_DATABASE_URL"]
    },
    "@repo/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/api-client/openapi.json"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "@repo/docs#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/api-client/openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
