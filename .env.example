# Every environment variable used in this repo, for reference.
# Each app and package has its own .env.example: copy it to .env in the same folder.
# The values below are for local development only. Never put real secrets in an .env.example file.

# packages/db, apps/api and apps/indexer
DATABASE_URL=postgres://app:app@localhost:5432/app

# Tests. They wipe this database, so its name must end in "_test".
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test

# apps/api
CORS_ORIGINS=http://localhost:5173
PORT=3001
LOG_LEVEL=info

# apps/indexer (its PORT is 3002)
HELIUS_WEBHOOK_SECRET=local-development-secret-not-for-production
